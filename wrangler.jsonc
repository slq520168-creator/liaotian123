{
  "name": "juese",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sirole.vip",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": false
  }
}
